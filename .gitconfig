[user]
    name = Shahbaz Tariq
    email = shahbaz@a1techdeals.com
    signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIBNpT8V49+NjrOkQGeAJLE6uP9Z1JXZ5AFCE6LFQcIeV

[gpg]
    format = ssh

[gpg "ssh"]
    program = "/Applications/1Password.app/Contents/MacOS/op-ssh-sign"

[commit]
    gpgsign = true

[github]
    user = shahbaztariq

[core]
    excludesfile = ~/.globalignore
    editor = nano
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true

[alias]
    # show changed files for a commit
    cf = show --pretty="format:" --name-only

    cleanup = "!git remote prune origin && git gc && git clean -df && git stash clear"

    # Useful aliases:
    ci = commit
    st = status -s
    br = branch
    cl = clone
    co = checkout

    # Ignore/unignore changes to files (like a local .gitignore)
    # http://durdn.com/blog/2012/11/22/must-have-git-aliases-advanced-examples/
    assume = update-index --assume-unchanged
    unassume = update-index --no-assume-unchanged

    assumed = "!git ls-files -v | grep ^h | cut -c 3-"
    assumeall = "!git status -s | awk {'print $2'} | xargs git assume"
    unassumeall = "!git assumed | xargs git update-index --no-assume-unchanged"

[help]
    # suggest the corrected command and ask, instead of a 0.1s countdown
    autocorrect = prompt

[push]
    default = current
    # create the upstream branch automatically on first push
    autoSetupRemote = true

[fetch]
    # drop local refs to branches deleted on the remote
    prune = true

[rebase]
    # stash/unstash automatically when rebasing with a dirty tree
    autostash = true

[rerere]
    # remember conflict resolutions and replay them
    enabled = true

[diff]
    tool = meld
    # render moved code distinctly from added/deleted (delta supports this)
    colorMoved = default

[merge]
    tool = meld
    # conflict markers include the common-base version
    conflictstyle = zdiff3

[difftool "meld"]
    prompt = false
    trustExitCode = true
    cmd = open -W -a Meld --args \"$LOCAL\" \"$PWD/$REMOTE\"

[mergetool "meld"]
    prompt = false
    trustExitCode = true
    cmd = open -W -a Meld --args --auto-merge \"$PWD/$LOCAL\" \"$PWD/$BASE\" \"$PWD/$REMOTE\" --output=\"$PWD/$MERGED\"

[url "git@github.com:"]
    insteadOf = https://github.com/

[init]
    defaultBranch = main

