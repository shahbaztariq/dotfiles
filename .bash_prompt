prompt_git() {
    local s='';
    local branchName='';

    # check if the current directory is in a git repository.
    if [ $(git rev-parse --is-inside-work-tree &>/dev/null; echo "${?}") == '0' ]; then
        # check if the current directory is in .git before running git checks.
        # skipped entirely if `git config bash.showDirtyState false` is set
        # (useful in huge repos where the status scan is slow).
        if [ "$(git rev-parse --is-inside-git-dir 2> /dev/null)" == 'false' ] && \
           [ "$(git config --get bash.showDirtyState)" != 'false' ]; then
            # one `git status` call covers staged, unstaged and untracked.
            local status=$'\n'"$(git status --porcelain --ignore-submodules 2> /dev/null)";

            # staged: any line whose first column is a change letter.
            [[ "${status}" == *$'\n'[MADRC]* ]] && s+='+';

            # unstaged: any line whose second column is M or D.
            [[ "${status}" == *$'\n'?[MD]* ]] && s+='!';

            # untracked files.
            [[ "${status}" == *$'\n''??'* ]] && s+='?';

            # stashed files (cheap ref lookup).
            git rev-parse --verify refs/stash &>/dev/null && s+='$';
        fi;

        # get the short symbolic ref.
        # if head isn’t a symbolic ref, get the short sha for the latest commit
        # otherwise, just give up.
        branchName="$(git symbolic-ref --quiet --short HEAD 2> /dev/null || \
            git rev-parse --short HEAD 2> /dev/null || \
            echo '(unknown)')";

        [ -n "${s}" ] && s=" [${s}]";

        echo -e "${1}${branchName}${peach}${s}";
    else
        return;
    fi;
}

# ansi palette: the terminal theme defines what each slot renders as, so
# the prompt automatically matches any ghostty theme — switch freely.
bold=$'\e[1m';
reset=$'\e[0m';
red=$'\e[31m';
green=$'\e[32m';
yellow=$'\e[33m';
blue=$'\e[34m';
mauve=$'\e[35m';   # magenta slot
subtext=$'\e[37m'; # "white" slot; a muted gray in most themes
peach=$'\e[91m';   # bright-red slot; orange/salmon in most themes

# highlight the user name when logged in as root.
if [[ "${USER}" == "root" ]]; then
    userStyle="${red}";
else
    userStyle="${blue}";
fi;

# highlight the hostname when connected via ssh.
if [[ "${SSH_TTY}" ]]; then
    hostStyle="${bold}${red}";
else
    hostStyle="${yellow}";
fi;

# set the terminal title to the current working directory.
PS1="\[\033]0;\w\007\]";
PS1+="\[${bold}\]\n"; # newline
PS1+="\[${userStyle}\]\u"; # username
PS1+="\[${subtext}\] at ";
PS1+="\[${hostStyle}\]\h"; # host
PS1+="\[${subtext}\] in ";
PS1+="\[${green}\]\w"; # working directory
PS1+="\$(prompt_git \"${subtext} on ${mauve}\")"; # Git repository details
PS1+="\n";
PS1+="\[${subtext}\]\$ \[${reset}\]"; # `$`
export PS1;

PS2="\[${yellow}\]→ \[${reset}\]";
export PS2;
