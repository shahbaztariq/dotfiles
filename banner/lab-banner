#!/usr/bin/env bash
# lab-banner: the host's name in big gradient letters and a live readout below it. Shown at SSH login by
# /etc/profile.d/zz-lab-banner.sh on the servers, in every new Ghostty tab on the Macs (bash_profile), and any time
# by running lab-banner. Managed by the lab repo (role banner; on the Macs, role mac links it in).
#
# On a Mac the settings and art are in ~/.config/lab-banner, and the readout is the Mac's: chip, macOS, uptime and
# load, battery, memory, the Data volume and network (no containers or updates there, by choice).
#
# The art is pre-rendered (figlet fonts ANSI Shadow and small) in /etc/lab-banner; the big one is used when it fits
# the terminal, then the small one, then the plain name. Colours are 24-bit; NO_COLOR=1 turns them off.
#
# It replaces the distro's login messages (pam_motd and sshd's "Last login" are off for SSH), so it carries their two
# useful lines: the pending updates (Ubuntu's own count, which leaves out phased updates; apt's on Debian) and the
# previous login. The login hook runs it with --login, which also records this login in
# ~/.local/state/lab-banner/last-login for next time; run by hand, it only shows the last one.
#
# With --login it also gives the terminal tab this host's theme (banner.conf's BANNER_THEME_*: all 16 colours, the
# text, background, cursor and selection: GitHub Dark with this host's accents), and the login
# hook runs `lab-banner --reset` when the login shell exits, which hands the tab back its own colours. A dropped
# connection never gets to the reset: type `reset` on the Mac. `lab-banner --theme` applies the theme again.

set -u
export LC_ALL=C.UTF-8
login=0; [ "${1:-}" = --login ] && login=1
mac=0; [[ "${OSTYPE}" == darwin* ]] && mac=1
dir=/etc/lab-banner
[ -d "$dir" ] || dir="$HOME/.config/lab-banner"
# uptime in seconds -> "4d 21h 3m"
since() { local u=$1 d h m; d=$((u / 86400)) h=$((u % 86400 / 3600)) m=$((u % 3600 / 60)); ((d)) && printf '%dd ' "$d"; printf '%dh %dm' "$h" "$m"; }
[ -r "$dir/banner.conf" ] && . "$dir/banner.conf"

# The terminal's colours: OSC 4 sets palette slots, 10 the text, 11 the background, 12 the cursor, 17 the selection;
# 104, 110, 111, 112 and 117 put them back to the terminal's own.
osc() { printf '\e]%s\a' "$1"; }
rgb() { local h=${1#\#}; printf 'rgb:%s/%s/%s' "${h:0:2}" "${h:2:2}" "${h:4:2}"; }
# the whole theme, so the tab looks the same whatever theme the terminal had: every palette slot ("n=#rrggbb ..."),
# then the text, background, cursor and selection
theme() {
    [ -n "${BANNER_THEME_PALETTE:-}" ] && [ -t 1 ] || return 0
    local slot
    for slot in $BANNER_THEME_PALETTE; do osc "4;${slot%%=*};$(rgb "${slot#*=}")"; done
    osc "10;$(rgb "$BANNER_THEME_FG")"; osc "11;$(rgb "$BANNER_THEME_BG")"
    osc "12;$(rgb "$BANNER_THEME_CURSOR")"; osc "17;$(rgb "$BANNER_THEME_SELECTION")"
}
case "${1:-}" in
    --reset) [ -t 1 ] && { osc 104; osc 110; osc 111; osc 112; osc 117; }; exit 0 ;;
    --theme) theme; exit 0 ;;
esac
((login)) && theme
: "${BANNER_FROM:=#7DD3FC}" "${BANNER_TO:=#A78BFA}" "${BANNER_TAGLINE:=}" "${BANNER_ROLE:=}"

color=1; [ -n "${NO_COLOR:-}" ] && color=0
# the terminal's width, from the terminal itself (tput, its output captured, says 80 on macOS whatever the width)
cols=; read -r _ cols < <({ stty size </dev/tty; } 2>/dev/null); cols=${cols:-80}
host=$(hostname -s)

R1=$((16#${BANNER_FROM:1:2})) G1=$((16#${BANNER_FROM:3:2})) B1=$((16#${BANNER_FROM:5:2}))
R2=$((16#${BANNER_TO:1:2})) G2=$((16#${BANNER_TO:3:2})) B2=$((16#${BANNER_TO:5:2}))

# fg <0..1000> [percent brightness]: REPLY = the escape for the gradient's colour at that point
fg() {
    local t=$1 k=${2:-100}
    ((color)) || { REPLY=; return; }
    REPLY=$'\e[38;2;'"$(( (R1 + (R2 - R1) * t / 1000) * k / 100 ));$(( (G1 + (G2 - G1) * t / 1000) * k / 100 ));$(( (B1 + (B2 - B1) * t / 1000) * k / 100 ))m"
}
if ((color)); then
    B=$'\e[1m' D=$'\e[2m' I=$'\e[3m' X=$'\e[0m' Y=$'\e[38;2;250;204;21m' RED=$'\e[38;2;248;113;113m' OK=$'\e[38;2;74;222;128m'
else
    B= D= I= X= Y= RED= OK=
fi
fg 0; C1=$REPLY; fg 1000; C2=$REPLY

# --- the name -------------------------------------------------------------------------------------------------
art=
for f in "$dir/art.txt" "$dir/art-small.txt"; do
    [ -r "$f" ] || continue
    lines=(); while IFS= read -r l || [ -n "$l" ]; do lines+=("$l"); done <"$f"   # not mapfile: macOS's bash 3.2 runs it too
    w=0; for l in ${lines[@]+"${lines[@]}"}; do ((${#l} > w)) && w=${#l}; done
    ((w + 4 <= cols)) && { art=$f; break; }
done

echo
if [ -n "$art" ]; then
    n=${#lines[@]} span=$((w + ${#lines[@]} * 4))
    for ((y = 0; y < n; y++)); do
        line=${lines[y]} out="  "
        for ((x = 0; x < ${#line}; x++)); do
            c=${line:x:1}
            if [[ $c == " " ]]; then out+=" "; continue; fi
            # a diagonal sweep; ANSI Shadow's box-drawing strokes are its shadow, so they get a darker shade
            case $c in [╗╔╝╚║═]) fg $(((x + y * 4) * 1000 / span)) 45 ;; *) fg $(((x + y * 4) * 1000 / span)) ;; esac
            out+="$REPLY$c"
        done
        printf '%s%s\n' "$out" "$X"
    done
else
    w=${#host}
    printf '  %s%s%s\n' "$B$C1" "$host" "$X"
fi

# a rule under the name in the same gradient, as wide as the art (at least 60), then the tagline
rw=$((w > 60 ? w : 60)); ((rw + 4 > cols)) && rw=$((cols - 4))
out="  "; for ((x = 0; x < rw; x++)); do fg $((x * 1000 / rw)); out+="${REPLY}━"; done
printf '%s%s\n' "$out" "$X"
[ -n "$BANNER_TAGLINE" ] && printf '  %s◆ %s%s%s\n' "$C2" "$I" "$BANNER_TAGLINE" "$X"
echo

# --- the readout ----------------------------------------------------------------------------------------------
row() { printf '  %s%-7s%s %s\n' "$C1$B" "$1" "$X" "$2"; }
sep="${D}·$X"

# bar <percent> [low]: 20 cells, the filled part in the gradient. The figure turns yellow at 75 % and red at 90 %,
# or with "low" (a battery), yellow under 40 % and red under 20 %.
bar() {
    local p=$1 i out= on=$(( ($1 * 20 + 50) / 100 )) pc=$X
    for ((i = 0; i < 20; i++)); do
        if ((i < on)); then fg $((i * 50)); out+="${REPLY}▰"; else out+="${D}▱$X"; fi
    done
    if [ "${2:-}" = low ]; then ((p < 40)) && pc=$Y; ((p < 20)) && pc=$RED
    else ((p >= 90)) && pc=$RED || { ((p >= 75)) && pc=$Y; }; fi
    REPLY="$out$X $pc$(printf '%3d%%' "$p")$X"
}
gib() { awk -v k="$1" 'BEGIN { g = k / 1048576; printf (g >= 100 ? "%.0f" : "%.1f"), g }'; }

if ((mac)); then
    chip=$(sysctl -n machdep.cpu.brand_string 2>/dev/null)
    row host "$B$host$X ${BANNER_ROLE:+$sep $BANNER_ROLE }${chip:+$sep $chip}"
    row os "$(sw_vers -productName) $(sw_vers -productVersion) $sep Darwin $(uname -r) $sep $(uname -m)"

    bt=$(sysctl -n kern.boottime | sed -E 's/^[{] sec = ([0-9]+),.*/\1/')   # "{ sec = 1790953757, usec = ... } ..."
    read -r _ l1 l5 l15 _ <<<"$(sysctl -n vm.loadavg)"
    row up "$(since $(($(date +%s) - bt))) $sep load $l1 $l5 $l15 $sep $(sysctl -n hw.ncpu) cpus"

    # battery: pmset's second line is "88%; <state>; <time> remaining present: true", where the state can be
    # charging, discharging, charged or "AC attached; not charging" (battery protection), and the time may be missing
    batt=$(pmset -g batt 2>/dev/null)
    if [[ $batt =~ ([0-9]+)%\;\ ([^$'\n']*) ]]; then
        bp=${BASH_REMATCH[1]} bs=${BASH_REMATCH[2]%% present:*}
        bs=${bs//; 0:00 remaining/}; bs=${bs//; (no estimate)/}; bs=${bs// remaining/ left}; bs=${bs//; / $sep }
        bar "$bp" low
        b="$REPLY  $bs"
        [[ $batt == *"'AC Power'"* && $bs != *AC* ]] && b+=" $sep on power"
        row battery "$b"
    fi

    # memory as Activity Monitor counts it: active, wired and compressed
    mt=$(($(sysctl -n hw.memsize) / 1024))
    mu=$(vm_stat | awk '/page size of/ { ps = $8 } /^Pages active:/ { a = $3 } /^Pages wired down:/ { w = $4 }
                       /^Pages occupied by compressor:/ { c = $5 } END { printf "%d", (a + w + c) * ps / 1024 }')
    bar $((mu * 100 / mt))
    row mem "$REPLY  $(gib "$mu") / $(gib "$mt") GiB"

    dv=/System/Volumes/Data; [ -d "$dv" ] || dv=/
    read -r _ dsize dused _ < <(df -Pk "$dv" | tail -1)
    bar $((dused * 100 / dsize))
    row disk "$REPLY  $(gib "$dused") / $(gib "$dsize") GiB"

    nif=$(route -n get default 2>/dev/null | awk '/interface:/ { print $2 }')
    # with an exit node the default route is Tailscale's tunnel: the LAN address is on the first real interface
    if [[ -z $nif || $nif == utun* ]]; then
        for i in $(ifconfig -l); do [[ $i == en* ]] && ipconfig getifaddr "$i" >/dev/null 2>&1 && { nif=$i; break; }; done
    fi
    lan=$( [ -n "$nif" ] && ipconfig getifaddr "$nif" 2>/dev/null)
    ts=$(ifconfig 2>/dev/null | awk '/inet 100\./ { print $2; exit }')
    row net "${lan:+lan $lan ${D}($nif)$X}${ts:+ $sep tailnet $ts}"
else
    . /etc/os-release
    os=$PRETTY_NAME
    if command -v pveversion >/dev/null; then
        os="Proxmox VE $(dpkg-query -W -f='${Version}' pve-manager 2>/dev/null) $sep $os"
    fi
    row host "$B$host$X ${BANNER_ROLE:+$sep $BANNER_ROLE}"
    row os "$os $sep $(uname -r) $sep $(uname -m)"

    read -r up _ </proc/uptime; upt=$(since "${up%.*}")
    read -r l1 l5 l15 _ </proc/loadavg
    temp=
    for h in /sys/class/hwmon/hwmon*; do
        [ "$(cat "$h/name" 2>/dev/null)" = coretemp ] && [ -r "$h/temp1_input" ] || continue
        t=$(($(cat "$h/temp1_input") / 1000)) tc=$OK
        ((t >= 70)) && tc=$Y; ((t >= 80)) && tc=$RED
        temp=" $sep cpu $tc${t}°C$X"; break
    done
    row up "$upt $sep load $l1 $l5 $l15 $sep $(nproc) cpus$temp"

    while read -r k v _; do
        case $k in MemTotal:) mt=$v ;; MemAvailable:) ma=$v ;; esac
    done </proc/meminfo
    bar $(((mt - ma) * 100 / mt))
    row mem "$REPLY  $(gib $((mt - ma))) / $(gib "$mt") GiB"

    read -r _ dsize dused _ < <(df -Pk / | tail -1)
    bar $((dused * 100 / dsize))
    row disk "$REPLY  $(gib "$dused") / $(gib "$dsize") GiB on /"

    lan=$(ip -4 -o addr show scope global 2>/dev/null | awk '$2 !~ /^(tailscale|docker|br-|veth|virbr|vmbr[1-9]|fwbr|tap)/ { sub(/\/.*/, "", $4); print $4; exit }')
    ts=$(ip -4 -o addr show dev tailscale0 2>/dev/null | awk '{ sub(/\/.*/, "", $4); print $4; exit }')
    row net "${lan:+lan $lan}${ts:+ $sep tailnet $ts}"
fi

if [ -d /run/qemu-server ]; then
    vms=()
    for p in /run/qemu-server/*.pid; do
        [ -e "$p" ] && kill -0 "$(cat "$p")" 2>/dev/null || continue
        id=$(basename "$p" .pid)
        vms+=("$(awk -F': ' '/^name:/ { print $2; exit }' "/etc/pve/qemu-server/$id.conf" 2>/dev/null || echo "$id")")
    done
    row vms "${#vms[@]} running${vms[*]:+ $sep ${vms[*]}}"
fi

if ! ((mac)) && command -v docker >/dev/null && [ -r /var/run/docker.sock ] && [ -w /var/run/docker.sock ]; then
    st=$(timeout 3 docker ps -a --format '{{.State}} {{.Status}}' 2>/dev/null) && {
        run=0 stop=0 sick=0
        while read -r s rest; do
            [ -n "$s" ] || continue
            [ "$s" = running ] && run=$((run + 1)) || stop=$((stop + 1))
            [[ $rest == *"(unhealthy)"* ]] && sick=$((sick + 1))
        done <<<"$st"
        d="$OK$run$X running"
        ((stop)) && d+=" $sep $stop stopped"
        ((sick)) && d+=" $sep $RED$sick unhealthy$X"
        row docker "$d"
    }
fi

if command -v zpool >/dev/null; then
    while read -r name health cap; do
        [ "$health" = ONLINE ] && hc=$OK || hc=$RED
        row zfs "$name $hc$health$X $sep $cap full"
    done < <(zpool list -H -o name,health,cap 2>/dev/null)
fi

# pending updates: Ubuntu's count from update-notifier (refreshed by its apt hook), else apt's
upd= sec=0
f=/var/lib/update-notifier/updates-available
if [ -r "$f" ]; then
    upd=$(sed -n 's/^\([0-9]\+\) updates\? can be applied immediately.*/\1/p' "$f" | head -1)
    sec=$(sed -n 's/^\([0-9]\+\) of these updates \(are\|is a\) \(standard \)\?security update.*/\1/p' "$f" | head -1)
    : "${upd:=0}" "${sec:=0}"
elif command -v apt >/dev/null; then
    list=$(apt list --upgradable 2>/dev/null | tail -n +2)
    upd=$(grep -c . <<<"$list") sec=$(grep -c -- '-security' <<<"$list")
fi
if [ -n "$upd" ]; then
    if ((upd == 0)); then
        u="${OK}up to date$X"
    else
        u="$Y$upd pending$X"; ((sec)) && u+=" $sep $RED$sec security$X"
        u+=" $sep ${D}apt list --upgradable$X"
    fi
    row updates "$u"
fi

# the previous login, from our own record (sshd's "Last login" is off); servers only, as on a Mac every new tab is a
# login
state=${XDG_STATE_HOME:-$HOME/.local/state}/lab-banner
if ((mac)); then
    :
elif [ -r "$state/last-login" ]; then
    read -r lt lfrom <"$state/last-login"
    ago=$(($(date +%s) - lt))
    if ((ago < 60)); then a="just now"
    elif ((ago < 3600)); then a="$((ago / 60))m ago"
    elif ((ago < 86400)); then a="$((ago / 3600))h ago"
    else a="$((ago / 86400))d ago"; fi
    # a name for the address: the tailnet's for 100.x, the router's reservations for the LAN
    who=
    if [[ $lfrom == 100.* ]] && command -v tailscale >/dev/null; then
        who=$(timeout 1 tailscale status 2>/dev/null | awk -v ip="$lfrom" '$1 == ip { print $2; exit }')
    elif [ -n "$lfrom" ] && [ -r "$dir/known-hosts" ]; then
        who=$(awk -v ip="$lfrom" '$1 == ip { $1 = ""; sub(/^ /, ""); print; exit }' "$dir/known-hosts")
    fi
    l="$(date -d "@$lt" '+%a %-d %b %H:%M') $sep $a"
    if [ -n "$who" ]; then l+=" $sep from $B$who$X $D($lfrom)$X"
    elif [ -n "$lfrom" ]; then l+=" $sep from $lfrom"; fi
    row last "$l"
else
    row last "${D}none recorded yet$X"
fi
if ((login)) && ! ((mac)); then
    mkdir -p "$state" 2>/dev/null && echo "$(date +%s) ${SSH_CONNECTION:+${SSH_CONNECTION%% *}}" >"$state/last-login" 2>/dev/null
fi

warn=()
[ -e /var/run/reboot-required ] && warn+=("reboot required")
failed=0; ((mac)) || failed=$(systemctl list-units --state=failed --no-legend --plain 2>/dev/null | wc -l)
((failed)) && warn+=("$failed failed unit$( ((failed > 1)) && echo s)")
if ((${#warn[@]})); then
    printf -v wl '%s · ' "${warn[@]}"
    printf '\n  %s▲ %s%s\n' "$Y$B" "${wl% · }" "$X"
fi
echo
