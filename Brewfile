# shell
brew "bash"             # macOS ships bash 3.2 (2007); this is 5.x
brew "bash-completion@2"  # v1 targets bash 3.2; v2 is maintained and lazy-loads
brew "fzf"

brew "gh"               # github cli, authenticated via 1password plugin

# colors & cli quality of life
brew "git-delta"        # syntax-highlighted git diffs
brew "eza"              # modern ls
brew "bat"              # syntax-highlighted cat

# apps the dotfiles depend on
cask "1password@beta"      # commit signing + secrets (see .exports)
cask "1password-cli@beta"
cask "meld"                # default git difftool/mergetool
cask "orbstack"            # shell integration in .bash_profile

# for a full snapshot of everything installed on this machine:
#   brew bundle dump --file=Brewfile.full
